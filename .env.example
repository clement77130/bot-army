# Bot Configuration
TOKEN=your_bot_token_here
# DATABASE_URL="file:./data/database.db"
CLIENT_ID=your_client_id_here
# Synchronisation automatique Roblox (en minutes, 0 = désactivée)
ROBLOX_SYNC_MINUTES=0

# Vérification par connexion Roblox (OAuth), comme RoWifi — facultatif
# URL publique HTTPS du bot (sans / final), ex: https://verif.mondomaine.fr
PUBLIC_URL=
# Le serveur web n'écoute que sur cette adresse/port (un reverse proxy ou un tunnel fait le lien avec Internet)
WEB_HOST=127.0.0.1
WEB_PORT=3000
# Portail Discord -> OAuth2 -> Client Secret
DISCORD_CLIENT_SECRET=
# Roblox Creator Dashboard -> OAuth 2.0 Apps
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
